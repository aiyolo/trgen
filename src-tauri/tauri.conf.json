{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StructSheet",
  "version": "0.7.1",
  "identifier": "com.structsheet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StructSheet · C 结构体转 Excel",
        "width": 1240,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "backgroundColor": [244, 242, 236, 255]
      },
      {
        "label": "excel-reader",
        "title": "StructSheet · Excel 阅读器",
        "url": "index.html?mode=reader",
        "width": 1420,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "backgroundColor": [244, 242, 236, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
